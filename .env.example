# IndiaGovWatch Environment Variables
# Copy this file to .env and fill in your values

# =============================================================================
# REQUIRED FOR PRODUCTION
# =============================================================================

# Supabase (Database)
# Get these from https://supabase.com/dashboard/project/YOUR_PROJECT/settings/api
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_KEY=your-service-role-key

# Razorpay (Payments)
# Get these from https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_live_xxxxx
RAZORPAY_KEY_SECRET=your-secret-key

# JWT Secret (for dashboard authentication)
# Generate a secure random string (min 32 characters)
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# =============================================================================
# EMAIL SERVICE (Choose one)
# =============================================================================

# Option 1: Resend (Recommended for production)
# Get API key from https://resend.com/api-keys
RESEND_API_KEY=re_xxxxx

# Email sender settings
FROM_EMAIL=IndiaGovWatch <notifications@indiagovwatch.in>
REPLY_TO_EMAIL=support@indiagovwatch.in

# Option 2: Gmail SMTP (for development/testing only)
# Note: Requires App Password, not regular Gmail password
# See: https://support.google.com/accounts/answer/185833
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password

# =============================================================================
# CRON JOBS
# =============================================================================

# Secret to protect cron endpoints from unauthorized access
# Generate a secure random string
CRON_SECRET=your-cron-secret-key

# =============================================================================
# OPTIONAL
# =============================================================================

# Server port (default: 3000)
PORT=3000

# =============================================================================
# SUPABASE SETUP INSTRUCTIONS
# =============================================================================
#
# 1. Create a new project at https://supabase.com
# 2. Go to Project Settings > API
# 3. Copy the URL and anon key
# 4. Go to Project Settings > API > Service Role key (keep this secret!)
# 5. Run the SQL schema in the Supabase SQL editor (see schema.sql)
#
# =============================================================================
# RESEND SETUP INSTRUCTIONS
# =============================================================================
#
# 1. Sign up at https://resend.com
# 2. Verify your domain (or use Resend's test domain for development)
# 3. Create an API key
# 4. Update FROM_EMAIL to use your verified domain
#
# =============================================================================
