{
  "version": 2,
  "crons": [
    {
      "path": "/api/cron/fetch-content",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/send-digests",
      "schedule": "0 2 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/dashboard",
      "destination": "/dashboard/index.html"
    }
  ]
}
